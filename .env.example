# ============================================================
# trend-dub config — copy file nay thanh `.env` roi chinh sua
#   cp .env.example .env   (mac/linux)
#   copy .env.example .env (windows)
# ============================================================

# --- Nguon lay trend Douyin (Evil0ctal API) ---
# Self-host: chay Douyin_TikTok_Download_API roi dien URL local, vi du http://127.0.0.1:80
# Hoac dung instance public (khong on dinh, chi de test nhanh): https://douyin.wtf
DOUYIN_API_BASE=https://douyin.wtf

# --- Dich (translation) ---
# Engine:
#   "free"   - Google dich cong khai, KHONG can cai dat/key (nhanh thu, do tin cay thap)
#   "ollama" - LLM tu host (free), can cai Ollama + pull model
#   "openai" - tra phi, chat luong cao nhat
TRANSLATE_ENGINE=free

# Ollama: phai cai app Ollama va `ollama pull <model>` truoc
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI (chi dung khi TRANSLATE_ENGINE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ngon ngu ---
# Ma ngon ngu nguon (video goc) va dich
SOURCE_LANG=zh
TARGET_LANG=vi

# --- Whisper (ASR) - chay bang transformers.js (thuan JS, khong can build) ---
# Model HuggingFace ONNX. CPU yeu -> whisper-base. Tot hon -> whisper-small.
#   Xenova/whisper-base | Xenova/whisper-small | onnx-community/whisper-large-v3-turbo
WHISPER_MODEL=Xenova/whisper-small

# --- TTS (Piper) ---
# Ten giong piper (vd: vi_VN-vais1000-medium). Setup script se tai ve.
PIPER_VOICE=vi_VN-vais1000-medium
