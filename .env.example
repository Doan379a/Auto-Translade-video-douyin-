# ============================================================
# trend-dub config — copy file nay thanh `.env` roi chinh sua
#   cp .env.example .env   (mac/linux)
#   copy .env.example .env (windows)
# ============================================================

# --- Nguon lay trend / tai video Douyin (Evil0ctal API) ---
# Mac dinh dung API SELF-HOST local (cong 8642) -> `npm run setup` tu cai, `npm run web`
# tu bat. Tai video KHONG can cookies, on dinh nhat. Public https://douyin.wtf de fallback.
# Nhieu base phan tach bang dau phay -> tu dong fallback khi 1 cai loi.
DOUYIN_API_BASE=http://127.0.0.1:8642,https://douyin.wtf

# --- Nguon trend ---
# "account" (MAC DINH, FREE): lay video moi nhat tu cac kenh trong data/accounts.json.
# "tikhub"  (TRA PHI): trend TOAN SAN qua TikHub (https://tikhub.io) - can key + URL endpoint.
TREND_SOURCE=account
# Chi khi TREND_SOURCE=tikhub: dien key + URL endpoint tra ve danh sach video (tuy goi TikHub cua ban).
TIKHUB_API_KEY=
TIKHUB_TREND_URL=

# Cookie Douyin (set 1 LAN, dung duoc hang tuan) -> API self-host tai on dinh, het loi 400.
# Cach lay: mo douyin.com (da xem 1 video) tren trinh duyet > F12 > Application > Cookies
#   > chon douyin.com > copy het thanh chuoi "ten1=giatri1; ten2=giatri2; ...".
# Hoac dung extension "Cookie-Editor" > Export > Header String. Dan vao day (1 dong).
DOUYIN_COOKIE=

# (Tuy chon) Thay vi cookie tren, co the cho yt-dlp lay cookies trinh duyet.
# De trong = tat. Gia tri: chrome | edge | firefox ... (Chrome/Edge moi co the bi ABE chan)
YTDLP_COOKIES_FROM_BROWSER=

# --- Dich (translation) ---
# Engine:
#   "free"   - Google dich cong khai, KHONG can cai dat. NHANH (~1-2p/video) - hop CPU.
#   "ollama" - LLM tu host (aya-expanse:8b), dich tu nhien hon nhung CHAM tren CPU (~10p/video, nen co GPU)
#   "openai" - tra phi, chat luong cao nhat
TRANSLATE_ENGINE=free

# Ollama: phai cai app Ollama va `ollama pull <model>` truoc.
# Khuyen dung aya-expanse:8b (dich Trung->Viet sach, tu nhien - tot hon qwen2.5).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=aya-expanse:8b

# OpenAI (chi dung khi TRANSLATE_ENGINE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ngon ngu ---
# Ma ngon ngu nguon (video goc) va dich
SOURCE_LANG=zh
TARGET_LANG=vi

# --- Whisper (ASR) - chay bang transformers.js (thuan JS, khong can build) ---
# Model HuggingFace ONNX. CPU yeu -> whisper-base. Tot hon -> whisper-small.
#   Xenova/whisper-base | Xenova/whisper-small | onnx-community/whisper-large-v3-turbo
WHISPER_MODEL=Xenova/whisper-small

# --- TTS (Piper) ---
# Ten giong piper MAC DINH (vd: vi_VN-vais1000-medium). Setup script se tai ve.
# Co the chon giong khac + chinh toc do NGAY TREN WEB (man duyet phu de).
PIPER_VOICE=vi_VN-vais1000-medium
# Toc do doc mac dinh: 1.0 = thuong, >1 nhanh hon, <1 cham hon
DUB_SPEED=1.0

# --- Phu de (burn vao video) ---
# Nen den om sat chu phu de dich: true | false
SUB_BG=true
SUB_FONT_SIZE=18
# Khoang cach tu day (px). Nho (vd 14) -> sat day, de len che phu de goc cua video.
SUB_MARGIN_V=14

# --- Nhac nen khi long tieng ---
# Cach xu ly nhac/tieng nen goc:
#   "duck"   - giu nhac nen goc, TU DONG ha nho khi long tieng noi (sidechain). Mac dinh, khong can cai them.
#   "demucs" - TACH HAN giong noi khoi nhac (Python demucs) -> giu nhac nen sach nhat. Can: pip install demucs.
#   "none"   - bo nhac nen goc, chi long tieng (giu rat nho theo ORIG_VOLUME ben duoi).
BGM_MODE=duck
# Am luong nhac nen (mode duck/demucs): 0..1. Mac dinh 0.85.
BGM_VOLUME=0.85
# Am luong tieng goc khi BGM_MODE=none: 0 = tat han, 0.06 = rat nho (mac dinh), 1 = nguyen ban
ORIG_VOLUME=0.06

# Toc do toi da khi co gian giong long tieng cho khop timeline (1.0 = khong tang, 1.5 mac dinh).
# Cau dich dai hon o trong -> tang toc den muc nay de tieng khong troi/chong cau sau.
DUB_MAX_TEMPO=1.5

# (Chi khi BGM_MODE=demucs) Lenh python co demucs. Vd: python | python3 | duong dan .venv/Scripts/python.exe
DEMUCS_PYTHON=python
DEMUCS_MODEL=htdemucs

# --- Metadata dang video ---
# Sinh tieu de / mo ta / hashtag tu ban dich, ghi ra output/<id>.meta.json: true | false
# (Engine dich free dung heuristic don gian; ollama/openai cho ket qua giat tit hon.)
GEN_METADATA=true

# --- Bao mat web ---
# Mat khau bao ve web khi mo ra mang LAN (de trong = khong yeu cau dang nhap).
# May chu (localhost) luon duoc mien. Cookie Douyin chi hien day du khi truy cap tu localhost.
WEB_PASSWORD=
